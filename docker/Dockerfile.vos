# syntax=docker/dockerfile:1
# PhotoCraft for VOS (com.ictrek.photocraft): the browser build served by nginx.
#
#   docker/build_image.sh                 # amd64 (or the host's architecture)
#   docker/build_image.sh --arch arm      # arm64, via buildx + qemu on an amd64 host
#
# The base is the root Dockerfile (the upstream community recipe); this file adds three changes
# that make it buildable on networks where GitHub releases and crates.io are slow or blocked:
#   - trunk and wasm-bindgen-cli are installed via cargo (not downloaded from GitHub releases)
#   - rustup uses the Tsinghua mirror for the wasm32 target
#   - cargo can be pointed at a crates.io mirror via CARGO_REGISTRY_MIRROR
# Nothing else differs, so the site this image serves is the upstream web build plus the VOS
# provenance labels.
#
# Keep WASM_BINDGEN_VERSION in sync with the wasm-bindgen pin in Cargo.lock, TRUNK_VERSION with
# .github/workflows/ci.yml / release.yml.

ARG RUST_VERSION=1.99
ARG NGINX_VERSION=1.28-alpine

FROM rust:${RUST_VERSION}-slim-bookworm AS builder
ARG TRUNK_VERSION=0.21.14
ARG WASM_BINDGEN_VERSION=0.2.129
ARG RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
# Override when crates.io is unreachable (e.g. behind the GFW):
#   CARGO_REGISTRY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/crates.io-index
ARG CARGO_REGISTRY_MIRROR=
ENV CARGO_REGISTRY_MIRROR=${CARGO_REGISTRY_MIRROR}
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown
# Install trunk via cargo so it uses the crates.io mirror instead of GitHub releases
# (unreliable behind the GFW). wasm-bindgen-cli was already cargo-installed above for the
# same reason; this makes trunk consistent with it.
RUN cargo install trunk --version "${TRUNK_VERSION}" --locked \
    && trunk --version
RUN cargo install wasm-bindgen-cli --version "${WASM_BINDGEN_VERSION}" --locked \
    && wasm-bindgen --version

WORKDIR /src
COPY . .
WORKDIR /src/apps/photocraft-web
ARG CARGO_PROFILE_WASM_RELEASE_LTO=thin
ARG CARGO_BUILD_JOBS=1
# Point cargo at a crates.io mirror so trunk build doesn't hit the GFW.
# Skipped when CARGO_REGISTRY_MIRROR is empty (the default: upstream builds are unaffected).
RUN if [ -n "${CARGO_REGISTRY_MIRROR}" ]; then \
        mkdir -p /root/.cargo && \
        printf '[source.crates-io]\nreplace-with = "mirror"\n[source.mirror]\nregistry = "sparse+%s"\n' "${CARGO_REGISTRY_MIRROR}" > /root/.cargo/config.toml; \
    fi
# Provenance shown in Help > About and in the image labels (crates/engine/src/build_info.rs).
ARG PHOTOCRAFT_BUILD_SHA=
ARG PHOTOCRAFT_BUILD_DATE=
ARG PHOTOCRAFT_VOS_VERSION=
ARG PHOTOCRAFT_UPSTREAM=
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/root/.cache/trunk \
    trunk build --release --locked \
    && test -s /src/dist/web/index.html \
    && gzip -9 -k /src/dist/web/*.wasm /src/dist/web/*.js /src/dist/web/index.html

FROM nginx:${NGINX_VERSION} AS runtime
LABEL org.opencontainers.image.title="PhotoCraft web" \
      org.opencontainers.image.description="PhotoCraft for VOS (com.ictrek.photocraft): the browser build, served by nginx" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.source="https://github.com/storytold/photocraft" \
      com.ictrek.vos.app="com.ictrek.photocraft"
# Filled in by docker/build_image.sh; empty for a plain docker build.
ARG PHOTOCRAFT_VOS_VERSION=
ARG PHOTOCRAFT_BUILD_SHA=
ARG PHOTOCRAFT_BUILD_DATE=
ARG PHOTOCRAFT_UPSTREAM=
LABEL org.opencontainers.image.version="${PHOTOCRAFT_VOS_VERSION}" \
      org.opencontainers.image.revision="${PHOTOCRAFT_BUILD_SHA}" \
      org.opencontainers.image.created="${PHOTOCRAFT_BUILD_DATE}" \
      com.ictrek.photocraft.upstream="${PHOTOCRAFT_UPSTREAM}"
COPY packaging/web/nginx.conf /etc/nginx/nginx.conf
# The upstream conf also listens on [::]:8080; on a host whose kernel has no IPv6 that bind fails
# and nginx exits at startup. The published port is IPv4 anyway.
RUN sed -i '/listen \[::\]:8080;/d' /etc/nginx/nginx.conf
COPY --from=builder /src/dist/web/ /usr/share/nginx/html/
COPY LICENSE-MIT LICENSE-APACHE NOTICE ATTRIBUTION.md /usr/share/nginx/html/
COPY assets/fonts/OFL-*.txt assets/icons/LICENSE-*.txt assets/dict/LICENSE-*.txt \
    crates/ui-egui/src/i18n/LICENSE-translations.txt /usr/share/nginx/html/licenses/
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
