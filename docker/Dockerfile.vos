# syntax=docker/dockerfile:1
# PhotoCraft for VOS (com.ictrek.photocraft): the browser build served by nginx.
#
#   docker/build_image.sh                 # amd64 (or the host's architecture)
#   docker/build_image.sh --arch arm      # arm64, via buildx + qemu on an amd64 host
#
# The base is the root Dockerfile (the upstream community recipe); this file adds two changes that
# make it buildable on networks where GitHub releases and crates.io are slow or blocked:
#   - trunk and wasm-bindgen-cli come from the toolchain image (docker/Dockerfile.toolchain) instead
#     of GitHub release downloads
#   - rustup and cargo use the Tsinghua mirrors
# Nothing else differs, so the site this image serves is the upstream web build plus the VOS
# provenance labels.
#
# The toolchain lives in its own image so its ~400-crate `cargo install` step is not invalidated by
# every change here (an ARG above `COPY . .` invalidates everything below it). Build and publish it
# with docker/build_toolchain.sh when RUST_VERSION, TRUNK_VERSION, WASM_BINDGEN_VERSION or
# WASM_OPT_VERSION changes; build_image.sh does not do it for you.
#
# Keep RUST_VERSION/TRUNK_VERSION/WASM_BINDGEN_VERSION/WASM_OPT_VERSION in sync with
# docker/Dockerfile.toolchain and docker/toolchain_tag.sh (which computes the tag),
# WASM_BINDGEN_VERSION with the wasm-bindgen pin in Cargo.lock, and TRUNK_VERSION with
# .github/workflows/ci.yml / release.yml.

ARG RUST_VERSION=1.99
ARG TRUNK_VERSION=0.21.14
ARG WASM_BINDGEN_VERSION=0.2.129
ARG WASM_OPT_VERSION=version_123
ARG NGINX_VERSION=1.28-alpine
# The fingerprint of the network knobs (CARGO_REGISTRY_MIRROR, GITHUB_ACCELERATOR) that the
# toolchain tag carries; docker/toolchain_tag.sh computes it. It only matters for the FROM line
# below: docker/build_image.sh passes a complete TOOLCHAIN_IMAGE and never uses this. The default is
# deliberately a placeholder that resolves to nothing, so a bare `docker build .` against non-default
# knobs fails to find an image instead of silently using one built with different settings.
ARG TOOLCHAIN_FINGERPRINT=unknown

# The per-architecture toolchain image. TOOLCHAIN_IMAGE overrides the whole reference (use it to
# build against a locally tagged toolchain that is not pushed yet); otherwise the registry,
# namespace, version ARGs above and the fingerprint compose it. TARGETARCH is set by BuildKit for
# both plain `docker build` and `docker buildx --platform`.
#
# docker/build_image.sh always passes TOOLCHAIN_IMAGE, so this fallback is for a bare
# `docker build .`; it duplicates the tag format in docker/toolchain_tag.sh.
ARG REGISTRY=swr.cn-southwest-2.myhuaweicloud.com
ARG NAMESPACE=ictrek
ARG TOOLCHAIN_IMAGE=
FROM ${TOOLCHAIN_IMAGE:-${REGISTRY}/${NAMESPACE}/photocraft-toolchain:rust${RUST_VERSION}-trunk${TRUNK_VERSION}-wasm-bindgen${WASM_BINDGEN_VERSION}-wasm-opt${WASM_OPT_VERSION#version_}-${TOOLCHAIN_FINGERPRINT}-${TARGETARCH}} AS builder

WORKDIR /src
COPY . .
WORKDIR /src/apps/photocraft-web
ARG CARGO_PROFILE_WASM_RELEASE_LTO=thin
# wasm-release is fat/thin LTO with codegen-units = 1: the highest peak memory in the workspace,
# where too many parallel rustc processes get the build OOM-killed (packaging/web/README.md).
# 8 suits a 32 GB+ builder; lower it with --build-arg CARGO_BUILD_JOBS=4 on a smaller one.
ARG CARGO_BUILD_JOBS=8
# Provenance shown in Help > About and in the image labels (crates/engine/src/build_info.rs).
ARG PHOTOCRAFT_BUILD_SHA=
ARG PHOTOCRAFT_BUILD_DATE=
ARG PHOTOCRAFT_VOS_VERSION=
ARG PHOTOCRAFT_UPSTREAM=
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/root/.cache/trunk \
    trunk build --release --locked \
    && test -s /src/dist/web/index.html \
    && gzip -9 -k /src/dist/web/*.wasm /src/dist/web/*.js /src/dist/web/index.html

# Installs the fonts the site serves from `fonts/manifest.txt` next to index.html
# (crates/ui-egui/src/served_fonts.rs) with scripts/vos-fonts.sh, the same script `make vos-dev`
# runs. The checkout is in the build context under `craft-fonts/`, the one path .dockerignore lets
# through.
COPY craft-fonts/ /craft-fonts/
RUN PHOTOCRAFT_WEB_FONTS_DIR=/craft-fonts bash /src/scripts/vos-fonts.sh /src/dist/web

FROM nginx:${NGINX_VERSION} AS runtime
LABEL org.opencontainers.image.title="PhotoCraft web" \
      org.opencontainers.image.description="PhotoCraft for VOS (com.ictrek.photocraft): the browser build, served by nginx" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.source="https://github.com/storytold/photocraft" \
      com.ictrek.vos.app="com.ictrek.photocraft"
# Filled in by docker/build_image.sh; empty for a plain docker build.
ARG PHOTOCRAFT_VOS_VERSION=
ARG PHOTOCRAFT_BUILD_SHA=
ARG PHOTOCRAFT_BUILD_DATE=
ARG PHOTOCRAFT_UPSTREAM=
LABEL org.opencontainers.image.version="${PHOTOCRAFT_VOS_VERSION}" \
      org.opencontainers.image.revision="${PHOTOCRAFT_BUILD_SHA}" \
      org.opencontainers.image.created="${PHOTOCRAFT_BUILD_DATE}" \
      com.ictrek.photocraft.upstream="${PHOTOCRAFT_UPSTREAM}"
COPY packaging/web/nginx.conf /etc/nginx/nginx.conf
# The upstream conf also listens on [::]:8080; on a host whose kernel has no IPv6 that bind fails
# and nginx exits at startup. The published port is IPv4 anyway.
RUN sed -i '/listen \[::\]:8080;/d' /etc/nginx/nginx.conf
COPY --from=builder /src/dist/web/ /usr/share/nginx/html/
COPY LICENSE-MIT LICENSE-APACHE NOTICE ATTRIBUTION.md /usr/share/nginx/html/
COPY assets/fonts/OFL-*.txt assets/icons/LICENSE-*.txt assets/dict/LICENSE-*.txt \
    crates/ui-egui/src/i18n/LICENSE-translations.txt /usr/share/nginx/html/licenses/
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
